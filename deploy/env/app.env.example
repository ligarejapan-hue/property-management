# =============================================================================
# property-management 本番環境変数テンプレート
# =============================================================================
# 配置先: /etc/property-management/app.env
# 権限:   sudo chmod 600 /etc/property-management/app.env
#         sudo chown root:root /etc/property-management/app.env
#
# 注意:
#   - このファイルは git にコミットしない（.gitignore で除外済み）
#   - シークレット実値はこのチャット・ログに貼らない
#   - AUTH_TRUST_HOST は HTTPS 本番環境では不要（入れないこと）
# =============================================================================

# ----------------------------------------------------------------------------
# [必須] データベース
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://<DB_USER>:<DB_PASS>@localhost:5432/<DB_NAME>"

# ----------------------------------------------------------------------------
# [必須] NextAuth / Auth.js
# 生成: openssl rand -hex 32
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET="<64文字以上のランダム文字列>"
NEXTAUTH_URL="https://<YOUR_DOMAIN>"

# ----------------------------------------------------------------------------
# [必須] ストレージサーバー
# ----------------------------------------------------------------------------
STORAGE_BACKEND=server
STORAGE_SERVER_URL="https://<STORAGE_SERVER_DOMAIN>"
STORAGE_SERVER_API_KEY="<STORAGE_API_KEY>"
STORAGE_SERVER_BUCKET=property-management

# ----------------------------------------------------------------------------
# [必須] 動作モード
# ----------------------------------------------------------------------------
NODE_ENV=production

# ----------------------------------------------------------------------------
# [推奨] 調査情報プロバイダ (KSJ 国土数値情報)
# 未設定 → KSJ プロバイダ無効（investigation は動作するが取得件数 0）
# ----------------------------------------------------------------------------
KSJ_API_URL="http://<GEOSERVER_HOST>/geoserver/ksj/ows"

# ----------------------------------------------------------------------------
# [オプション] 取込動作設定
# needs_review: 棟未存在時に needs_review ステータスで記録（デフォルト）
# auto_create:  棟を自動作成
# ----------------------------------------------------------------------------
UNIT_IMPORT_BUILDING_NOT_FOUND=needs_review

# ----------------------------------------------------------------------------
# [オプション] 謄本自動取得（registry auto-fetch / 22-A トラックB・PR-2 live）
# 公式「登記情報提供サービス」を Playwright で自動操作して謄本 PDF を取得する。
#   - 既定（未設定）: getRegistryFetchProvider() が null → API 501・UI ボタン disabled（本番挙動不変）
#   - live 化は **明示 opt-in**: 下記をすべて設定し、かつ事前に Playwright/chromium を
#     ホストへ配置すること（PLAYWRIGHT_BROWSERS_PATH を www-data 所有で固定 →
#     npx playwright install chromium / install-deps chromium）。
#   - 資格情報は server-side のみ・NEXT_PUBLIC_ 禁止・ログに出さない。値はチャットに貼らない。
#   注意: このテンプレは systemd EnvironmentFile= で読まれる。各行は有効化時に行頭 "# " を外すだけで
#   そのまま NAME=VALUE になるため、値の後ろにインライン注釈を書かないこと（インライン # は値の一部に
#   なり、REGISTRY_FETCH_PROVIDER の厳密 "official" / SELECTORS_CALIBRATED の厳密 "true" 判定に失敗する）。
#   - REGISTRY_FETCH_PROVIDER: live 化の opt-in（"official" のときだけ実 adapter を配線）
# REGISTRY_FETCH_PROVIDER=official
#   - REGISTRY_FETCH_SELECTORS_CALIBRATED: セレクタ校正済みの明示宣言（CodexP1）。
#     "true" でない限り opt-in しても provider は null=501 維持（誤セレクタで実サイト操作させない）
# REGISTRY_FETCH_SELECTORS_CALIBRATED=true
# REGISTRY_FETCH_LOGIN_ID="<利用者識別番号>"
# REGISTRY_FETCH_PASSWORD="<パスワード>"
#   - REGISTRY_FETCH_BASE_URL: 省略時は既定 https://www1.touki.or.jp
# REGISTRY_FETCH_BASE_URL="<公式サービスのベースURL>"
# REGISTRY_FETCH_TIMEOUT_MS=30000
#   - REGISTRY_FETCH_MIN_INTERVAL_MS: 第12条の2 回避の最小取得間隔
# REGISTRY_FETCH_MIN_INTERVAL_MS=60000
# PLAYWRIGHT_BROWSERS_PATH=/var/lib/property-management/ms-playwright

# ----------------------------------------------------------------------------
# [将来実装] 追加プロバイダ
# ----------------------------------------------------------------------------
# NTA_ROSENKA_API_URL=
# ROAD_LEDGER_API_URL=
# GOOGLE_MAPS_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=noreply@<YOUR_DOMAIN>
