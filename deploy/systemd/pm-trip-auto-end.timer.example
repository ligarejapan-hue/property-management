# =============================================================================
# 巡回の自動終了 — タイマー (10分ごと)
# =============================================================================
# 閾値は1時間なので、10分間隔なら「1時間〜1時間10分」で終了する。
# 分単位の精度は業務上不要なため、短くして負荷を上げない。
# =============================================================================

[Unit]
Description=Run field-survey trip auto-end every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
# 各ホストで実行時刻をばらす (同時刻集中を避ける)。
RandomizedDelaySec=60
Persistent=true
Unit=pm-trip-auto-end.service

[Install]
WantedBy=timers.target
