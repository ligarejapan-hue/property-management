# 画面を閉じていても届く通知(Web プッシュ)の送信 — 2分ごと(通知 段階4b)。
# 時刻ありの次回対応は「5分前」に送るので、間隔は5分より十分短くする。
# ⚠有効にするのは反映の**最後**、戻すときは**最初に**止める(docs/deploy.md)。
[Unit]
Description=Run web push notifications every 2 minutes

[Timer]
OnBootSec=3min
# ⚠前回が**終わってから**2分(OnUnitInactiveSec)。OnUnitActiveSec(始まりから)だと、1回が2分を超えたとき
#   次の起動が「実行中なので見送り」になり、その後 timer が二度と動かなくなる(@codex #472 P1)。
OnUnitInactiveSec=2min
AccuracySec=15s
Unit=pm-push-notify.service

[Install]
WantedBy=timers.target
