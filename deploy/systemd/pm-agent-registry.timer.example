# =============================================================================
# 国交省の業者一覧を集める — タイマー (夜間 22:00〜翌7:00 のあいだ10分ごと)
# =============================================================================
# 時刻は**サーバーの時計の時刻**(本番は Asia/Tokyo)。route 側でも日本時間の夜間かを確かめ、
# 外なら先方にアクセスせずに終わる(二重の守り)。
# =============================================================================

[Unit]
Description=Run MLIT agent registry collection every 10 minutes at night

[Timer]
OnCalendar=*-*-* 22,23,00,01,02,03,04,05,06:00/10:00
RandomizedDelaySec=60
Persistent=false
Unit=pm-agent-registry.service

[Install]
WantedBy=timers.target
