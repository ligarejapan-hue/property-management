# =============================================================================
# 国交省の業者一覧を集める — タイマー (終日10分ごとに route を呼ぶ)
# =============================================================================
# 動いてよい時間かは **route 側が決める**: 日本時間 22:00〜翌7:00 と、
# app.env の AGENT_REGISTRY_DAYTIME_DAYS に書いた日(祝日など・終日)だけ。
# それ以外の時間に呼ばれた回は、先方にアクセスせずにすぐ終わる(stopped=outside_window)。
# 時刻は**サーバーの時計の時刻**(本番は Asia/Tokyo)。
# =============================================================================

[Unit]
Description=Run MLIT agent registry collection every 10 minutes (route allows night and listed days only)

[Timer]
OnCalendar=*-*-* *:00/10:00
RandomizedDelaySec=60
Persistent=false
Unit=pm-agent-registry.service

[Install]
WantedBy=timers.target
