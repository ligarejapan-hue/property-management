# ============================================================
# 物件管理システム - 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください。
# 本番デプロイの詳細は docs/deploy.md を参照。
# ============================================================

# ----------------------------------------------------------------
# [必須] データベース
# ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_management"

# ----------------------------------------------------------------
# [必須] NextAuth / Auth.js
# ----------------------------------------------------------------
# 本番: openssl rand -hex 32 で生成した値を設定すること
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"

# 本番: "https://your-domain.com" に変更すること
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------
# [必須（本番）] ストレージ
# 開発: local (public/uploads/ に書き込み、追加設定不要)
# 本番: server (STORAGE_SERVER_* の設定も必要)
# ----------------------------------------------------------------
STORAGE_BACKEND=local

# STORAGE_BACKEND=local の保存先ルート（絶対パス）。
# 未設定なら ${cwd}/public/uploads（既存互換、開発でそのまま動く）。
# 本番でリポジトリ外に保存先を逃がしたい場合に指定する。
# LOCAL_UPLOAD_ROOT=/var/lib/property-management/uploads

# STORAGE_BACKEND=server の場合に設定:
# STORAGE_SERVER_URL=https://files.your-domain.com
# STORAGE_SERVER_API_KEY=your-api-key-here
# STORAGE_SERVER_BUCKET=property-management

# 開発用モックサーバー: npm run storage:mock
# STORAGE_SERVER_URL=http://localhost:4000
# STORAGE_SERVER_API_KEY=test-api-key

# STORAGE_BACKEND=s3 の場合に設定 (S3 互換: AWS S3 / Cloudflare R2 / MinIO 共通):
#   - AWS S3: STORAGE_S3_ENDPOINT は未設定でよい
#   - Cloudflare R2: STORAGE_S3_REGION=auto, STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   - MinIO: STORAGE_S3_FORCE_PATH_STYLE=true, STORAGE_S3_ENDPOINT=http://minio:9000
# 配信は /uploads/[...path] proxy 経由 (既存 DB の fileUrl=/uploads/... 互換)。
# signed URL は Phase 2 未対応。
# STORAGE_S3_BUCKET=property-management
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_FORCE_PATH_STYLE=false

# ----------------------------------------------------------------
# [推奨] 調査情報プロバイダ (investigation)
# 国土数値情報 A29 (用途地域・建蔽率・容積率・防火地域)
# 設定なし → KSJ プロバイダ無効 (機能は動作するが取得件数 0)
# ----------------------------------------------------------------

# 開発用モックサーバー: npm run ksj:mock (port 9000)
# KSJ_API_URL=http://localhost:9000/geoserver/ksj/ows

# 本番: GeoServer WFS エンドポイント
# KSJ_API_URL=http://your-geoserver.com/geoserver/ksj/ows

# ----------------------------------------------------------------
# [オプション] 取込動作設定
# ----------------------------------------------------------------

# 区分（unit）取込時、棟が未存在の場合の動作
#   needs_review : needs_review ステータスで取込ジョブに記録 (デフォルト)
#   auto_create  : 棟を自動作成
UNIT_IMPORT_BUILDING_NOT_FOUND=needs_review

# ----------------------------------------------------------------
# [オプション] 国税庁 法人番号 Web-API (Phase B preview)
# 法人番号 → 会社名・所在地の lookup preview に使う。Owner 行への反映はしない。
# 公式: https://www.houjin-bangou.nta.go.jp/webapi/index.html
#   - CORPORATE_NUMBER_API_APP_ID 未設定 → 検索 API は 503 NOT_CONFIGURED、UI ボタンは disabled
#   - URL は version 4 / num エンドポイントを既定とする
#   - type=12 は UTF-8 XML を返す（JSON ではない）
# ----------------------------------------------------------------
# CORPORATE_NUMBER_API_APP_ID=
# CORPORATE_NUMBER_API_URL=https://api.houjin-bangou.nta.go.jp/4/num
# CORPORATE_NUMBER_API_TIMEOUT_MS=8000

# ----------------------------------------------------------------
# [オプション] 住所補完 API (郵便番号 ⇄ 住所)
# 日本郵便 郵便番号・デジタルアドレス API を server-side proxy 経由で利用する。
# client から外部APIを直接呼ばず、必ず /api/address/lookup/* を経由する。
#   - ADDRESS_LOOKUP_API_KEY / CLIENT_ID / BASE_URL / SOURCE_IP のいずれか未設定
#     → /api/address/lookup/* は 503 NOT_CONFIGURED（UI は補完ボタンを disabled にできる）
#   - 入力不正 400 / 外部API失敗 502 / 候補なし []
#   - APIキー(secret)は server-side のみ。絶対に NEXT_PUBLIC_ にしないこと
#   - BASE_URL は日本郵便の組織/サービス配下 systems エンドポイントを設定する
#   - 値はこのファイル(.env.example)には書かず、.env(gitignore)に設定する
# ----------------------------------------------------------------
# ADDRESS_LOOKUP_PROVIDER=japanpost
# ADDRESS_LOOKUP_API_KEY=
# ADDRESS_LOOKUP_CLIENT_ID=
# ADDRESS_LOOKUP_BASE_URL=
#   ADDRESS_LOOKUP_SOURCE_IP: 日本郵便に登録済みのサーバ送信元グローバル IP。
#   token 取得時に x-forwarded-for で送る（IP ベース認可）。inbound request の XFF は使わない。
#   secret ではないがログには出さない方針。japanpost で未設定だと 503 NOT_CONFIGURED。
# ADDRESS_LOOKUP_SOURCE_IP=
# ADDRESS_LOOKUP_TIMEOUT_MS=8000

# ----------------------------------------------------------------
# [オプション] 謄本自動取得（registry auto-fetch / 22-A トラックB）
# 公式「登記情報提供サービス」を server-side のヘッドレスブラウザ（Playwright）で
# 自動操作して謄本 PDF を取得する（公開 API なし）。
#   - REGISTRY_FETCH_LOGIN_ID / REGISTRY_FETCH_PASSWORD のいずれか未設定
#     → getRegistryFetchProvider() が null → API は 501（PROVIDER_NOT_CONFIGURED）、
#       UI の自動取得ボタンは disabled のまま（= 本番挙動不変）
#   - 資格情報（ID/PW）は server-side のみ。絶対に NEXT_PUBLIC_ にしないこと・ログに出さないこと
#   - 値はこのファイル(.env.example)には書かず、.env / 本番 app.env(gitignore)に設定する
#   - PR-2（live 化）: 実 Playwright adapter は **次の両方** が揃ったときだけ配線される。
#       (a) REGISTRY_FETCH_PROVIDER=official（明示 opt-in）
#       (b) REGISTRY_FETCH_SELECTORS_CALIBRATED=true（セレクタ校正済みの明示宣言・CodexP1）
#     資格情報だけ・あるいは opt-in だけでは null=501 維持（chromium 未配置やセレクタが TODO
#     プレースホルダのまま capability=true にして「常に失敗する操作（誤セレクタでの実サイト操作）」を
#     露出しないため）。opt-in + 校正フラグは **playwright/chromium をホストへ配置
#     （npx playwright install chromium）し、かつ実サイトに合わせてセレクタを校正してコードへ反映した後**
#     に、運用 runbook 手順で設定すること。
# ----------------------------------------------------------------
#   REGISTRY_FETCH_PROVIDER: live 化の opt-in。"official" のときだけ実 adapter を配線（既定: 無効）。
# REGISTRY_FETCH_PROVIDER=official
#   REGISTRY_FETCH_SELECTORS_CALIBRATED: セレクタ校正済みの明示宣言（CodexP1）。"true" のときだけ
#     本番経路の provider を有効化する。コード内 REGISTRY_SELECTORS は TODO プレースホルダのため、
#     実サイトで校正しコードへ反映してからこのフラグを立てる（"true" 以外＝未校正扱いで 501 維持）。
# REGISTRY_FETCH_SELECTORS_CALIBRATED=true
# REGISTRY_FETCH_LOGIN_ID=
# REGISTRY_FETCH_PASSWORD=
#   REGISTRY_FETCH_BASE_URL: 公式サービスのベース URL
#     省略時は provider 既定（DEFAULT_REGISTRY_BASE_URL = https://www1.touki.or.jp）を使う。
#     live キャリブレーションで実サイトのサブドメイン/パスが確定したらここで上書きする。
# REGISTRY_FETCH_BASE_URL=
#   REGISTRY_FETCH_LOGIN_PATH: ログインページのパス（base URL に前置する相対パス）。
#     省略時は provider 既定（DEFAULT_REGISTRY_LOGIN_PATH = /login）を使う。実サービスの正確な
#     login エンドポイントは実ログイン環境でのみ確証できるため（TODO(calibrate)）、誤った固定値で
#     確定せず、live 校正時はまずこの env で上書きして検証してからコード既定へ反映する運用とする。
# REGISTRY_FETCH_LOGIN_PATH=/login
# REGISTRY_FETCH_TIMEOUT_MS=30000
#   レート制御（約款第12条の2: 過度な検索回避）。最小取得間隔（ミリ秒）。
#   throttle のラッパに渡す想定（PR-2 以降で配線）。
# REGISTRY_FETCH_MIN_INTERVAL_MS=60000

# ----------------------------------------------------------------
# [開発専用] モックモード
# DB が未接続の場合に true にするとモックデータで動作する
# ----------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK=

# ----------------------------------------------------------------
# [将来実装] 追加プロバイダ・外部連携
# ----------------------------------------------------------------

# 路線価 API (将来実装)
# NTA_ROSENKA_API_URL=
# NTA_ROSENKA_API_KEY=

# 道路台帳 API (将来実装)
# ROAD_LEDGER_API_URL=

# ----------------------------------------------------------------
# Google Maps JavaScript API (現地調査マップ / Phase 1-E〜)
# ----------------------------------------------------------------
# 現時点では Google Maps API による課金を行わない方針。
# 将来課金を許容する場合でも、本番有効化前に下記チェックリストの完了を必須とする。
#
# 本番利用前に必ず Google Cloud Console で完了させること:
#   1. Cloud Billing の Budget / Alert を設定する
#   2. Maps JavaScript API の quota / usage cap を設定する
#      (注: Budget alert は通知のみで課金を停止しない。
#       実際に上限で止めるには quota 制限を別途設定する必要がある)
#   3. APIキーに HTTP referrer 制限を設定する
#      (許可例: localhost:3000 / 本番ドメインのみ)
#   4. APIキーの「API 制限」を Maps JavaScript API のみに限定する
#   5. 管理者による本番利用承認を得る
#
# 料金体系 (無料枠 / 単価) は変動するため本ファイルには記載しない。
# 最新の費用は Google 公式の料金ページで確認すること。
#
# client 側で初期化するため NEXT_PUBLIC_ で expose する。
# 未設定でも /field-survey/map 画面はクラッシュせず案内を表示する。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps の Map ID (現地調査マップで AdvancedMarker を使うため必須)。
# 未設定で地図を描画するとマーカーが一切表示されない壊れた UI になるため、
# /field-survey/map は MAP_ID 未設定時に Maps JavaScript API を読み込まず
# fallback 画面を表示する。
# Google Cloud Console > Google Maps Platform > Map Management で作成すること。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# 上記 1〜5 のチェックリストを管理者が確認済の場合のみ "true" にする。
# 未設定 / "true" 以外なら /field-survey/map に「未確認」警告 UI を出し続ける。
# このフラグは課金停止や制限の機能ではなく、警告 UI の dismiss にのみ使う。
NEXT_PUBLIC_GOOGLE_MAPS_BILLING_ACKNOWLEDGED=

# (旧) Google Maps API (server 側 Geocoding を将来導入する場合のみ)
# GOOGLE_MAPS_API_KEY=

# メール送信 / パスワードリセット (将来実装)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com
